# Copy to .env.local and fill in. .env.local is gitignored — never commit the token.

# Airtable personal access token (read scope on the Mercury base). Server-only;
# the browser never receives it. Same base/token family as mercury-consumer.
AIRTABLE_TOKEN=

# Ops Relay (mercury-server) — how team WhatsApp notifications are sent.
# BOTH are required; with either missing, notifyTeam logs the message and sends
# nothing. This app no longer needs WHAPI_TOKEN — the whapi token lives only on
# the relay, so a compromise here cannot reach WhatsApp directly.
# Values: `flyctl ssh console -a mercury-server -C 'printenv MERCURY_APP_KEY'`
MERCURY_APP_KEY=
OPS_RELAY_SECRET=
