# Copy to .env.local and fill in. .env.local is gitignored — never commit a token.

# Airtable personal access token for the Mercury base. Server-only; the browser
# never receives it. Reads the trips/bookings; also WRITES the booking editor and
# the concierge inbox's drafts and claims, so it needs write scope on the base.
AIRTABLE_TOKEN=

# ── Auth (Google SSO) ──────────────────────────────────────────────────────
# Leave AUTH_GOOGLE_ID unset for local dev and the app does not require a login.
# Set it and every route requires a session on the allowlist.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. A whole domain is written "@example.com".
OPS_ALLOWED_EMAILS=

# ── Concierge inbox (/inbox) ───────────────────────────────────────────────
# Reading threads and saving drafts needs nothing beyond AIRTABLE_TOKEN.
#
# These two are what let ops SEND from this app and get the real answer on
# screen ("delivered", or "this guest is opted out"). Both are required: the
# /internal routes on mercury-server sit behind two guards, and one without the
# other is a 401. Copy the values from the mercury-server Fly secrets of the
# same names.
#
# Without them the app still works: pressing send ticks the box in Airtable and
# the existing "Concierge — send reply" automation delivers it, and the UI says
# so rather than claiming a send it did not witness.
MERCURY_APP_KEY=
CONCIERGE_OPS_SECRET=
# Only to point at a non-production server. Defaults to https://mercury-server.fly.dev
MERCURY_SERVER_URL=

# ── Team WhatsApp notifications (booking editor) ───────────────────────────
# Unset in local dev: notifyTeam logs the message instead of sending it.
WHAPI_TOKEN=
